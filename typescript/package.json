{
  "name": "metergraph",
  "version": "0.6.12",
  "description": "Zero-dependency TypeScript SDK for function-level LLM cost attribution across major LLM providers and frameworks, including OpenAI, Anthropic, Gemini, and Vercel AI SDK.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.mjs"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "node scripts/prepare-build.mjs && tsc -p tsconfig.json && node scripts/finish-build.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm test && npm run test:package",
    "test": "npm run build && npm run test:types && npm run test:examples && node --test test/*.test.mjs",
    "test:examples": "tsc --noEmit --strict --skipLibCheck --target ES2022 --module NodeNext --moduleResolution NodeNext test/ai-sdk-factories.types.ts",
    "test:openai-v4": "npm run build && node --test test/compatibility/openai-v4.test.mjs",
    "test:package": "npm run build && node --test test/package/packed-package.test.mjs",
    "test:types": "tsc --noEmit --strict --skipLibCheck --target ES2022 --module NodeNext --moduleResolution NodeNext test/ai-sdk-current.types.ts test/wrap-gateway.types.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "Apache-2.0",
  "author": "Metergraph",
  "homepage": "https://www.metergraph.dev/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metergraph/metergraphsdk.git",
    "directory": "typescript"
  },
  "bugs": {
    "url": "https://github.com/metergraph/metergraphsdk/issues"
  },
  "keywords": [
    "llm",
    "llm-cost",
    "llm-observability",
    "cost-attribution",
    "ai-agents",
    "openai",
    "anthropic",
    "gemini",
    "vercel-ai-sdk",
    "opentelemetry",
    "self-hosted"
  ],
  "dependencies": {},
  "devDependencies": {
    "@ai-sdk/anthropic": "^4.0.39",
    "@ai-sdk/openai": "^4.0.43",
    "@ai-sdk/openai-compatible": "^3.0.31",
    "@anthropic-ai/sdk": "^0.30",
    "@google/genai": "^1",
    "@types/node": "^24.0.0",
    "ai": "^7.0.55",
    "openai": "^7",
    "typescript": "^5.8.0"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.30",
    "@google/genai": ">=1",
    "ai": ">=5 <8",
    "openai": ">=4 <8"
  },
  "peerDependenciesMeta": {
    "openai": {"optional": true},
    "@anthropic-ai/sdk": {"optional": true},
    "@google/genai": {"optional": true},
    "ai": {"optional": true}
  }
}
